# Copy to .env in this directory to override defaults.
# All values below are optional — sane defaults are baked into compose.yml.

# --- Images to run ---
OPENCTI_IMAGE=opencti/platform:rolling
OPENCTI_WORKER_IMAGE=opencti/worker:rolling
OPENCTI_WORKER_REPLICAS=2

# --- Ports (host side) ---
OPENCTI_PORT=8080

# --- Credentials ---
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=opencti-password
