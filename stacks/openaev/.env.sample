# Copy to .env in this directory to override defaults.
# All values below are optional — sane defaults are baked into compose.yml.

# --- Image to run ---
# Use a released tag to just spin up OpenAEV without building locally:
#   OPENAEV_IMAGE=openaev/platform:rolling
# Or build your own local checkout first (see scripts/spawn-openaev.sh --build):
#   OPENAEV_IMAGE=openaev-dev:latest
OPENAEV_IMAGE=openaev/platform:rolling

# --- Ports (host side) ---
OPENAEV_PORT=8081
MAILPIT_WEB_PORT=8026
MAILPIT_SMTP_PORT=1026

# --- Credentials ---
POSTGRES_USER=openaev
POSTGRES_PASSWORD=openaev-password
POSTGRES_DB=openaev
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RABBITMQ_DEFAULT_USER=openaev
RABBITMQ_DEFAULT_PASS=rabbitmq-password

OPENAEV_ADMIN_EMAIL=admin@openaev.io
OPENAEV_ADMIN_PASSWORD=OpenAEVDevExp2026
OPENAEV_ADMIN_TOKEN=8c23fc1c-0196-4aa1-8aa1-6e21aae6a1b5
OPENAEV_HEALTHCHECK_KEY=healthcheck-dev-key
OPENAEV_ADMIN_ENCRYPTION_KEY=0OhSkm3ZvFgu3KLgGmKbVNafRuwryqeg
OPENAEV_ADMIN_ENCRYPTION_SALT=i4TJssA4vjxqXiLO

